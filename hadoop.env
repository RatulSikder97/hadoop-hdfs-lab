# Shared HDFS + YARN config for the unified multi-PC cluster.
# bde2020 env->xml naming: '_' -> '.', '___' -> '-'
#
# NOTE: this is an env_file, so Docker does NOT expand ${MASTER_IP} here.
# The Master PC IP (10.100.201.151) is therefore hardcoded below. Only the
# 'environment:' blocks in docker-compose.yml interpolate ${WORKER_IP}.

# Where everyone finds the NameNode (Master PC LAN IP)
CORE_CONF_fs_defaultFS=hdfs://10.100.201.151:9000

# Where NodeManagers / clients find the YARN ResourceManager (Master PC LAN IP)
YARN_CONF_yarn_resourcemanager_hostname=10.100.201.151

# Replication factor (every block copied to this many DataNodes)
HDFS_CONF_dfs_replication=2

# Don't reverse-resolve DataNode IPs to hostnames (cross-host registration)
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname___check=false

# NameNode binds all interfaces but advertises fs.defaultFS host
HDFS_CONF_dfs_namenode_rpc___bind___host=0.0.0.0
HDFS_CONF_dfs_namenode_servicerpc___bind___host=0.0.0.0
HDFS_CONF_dfs_namenode_http___bind___host=0.0.0.0

# Reach DataNodes by their advertised hostname/IP (works across hosts)
HDFS_CONF_dfs_client_use_datanode_hostname=true
HDFS_CONF_dfs_datanode_use_datanode_hostname=true

# --- MapReduce on YARN ------------------------------------------------------
# Without this, the client runs jobs with the LocalJobRunner (job_local...,
# single JVM) and NEVER touches the workers. 'yarn' makes it submit to the
# ResourceManager so map/reduce tasks run in containers on the worker PCs.
MAPRED_CONF_mapreduce_framework_name=yarn
YARN_CONF_yarn_resourcemanager_address=10.100.201.151:8032
# AM + map + reduce containers need to find the Hadoop jars on the workers:
MAPRED_CONF_yarn_app_mapreduce_am_env=HADOOP_MAPRED_HOME=/opt/hadoop-3.2.1
MAPRED_CONF_mapreduce_map_env=HADOOP_MAPRED_HOME=/opt/hadoop-3.2.1
MAPRED_CONF_mapreduce_reduce_env=HADOOP_MAPRED_HOME=/opt/hadoop-3.2.1
MAPRED_CONF_mapreduce_application_classpath=/opt/hadoop-3.2.1/share/hadoop/mapreduce/*:/opt/hadoop-3.2.1/share/hadoop/mapreduce/lib/*
# Let YARN see containers' real resource use without killing them in the VM:
YARN_CONF_yarn_nodemanager_vmem___check___enabled=false
YARN_CONF_yarn_nodemanager_pmem___check___enabled=false
