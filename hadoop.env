# Shared HDFS config for the three-PC cluster (lab-3).
# NameNode lives on 10.100.200.101 (this PC); three DataNodes join over the LAN
# (10.100.200.112, 10.100.201.210, and a third PC).
#
# bde2020 env->xml naming: '_' -> '.', '___' -> '-'
# (so dfs_namenode_rpc___bind___host  ==  dfs.namenode.rpc-bind-host)

# Where everyone finds the NameNode (advertised LAN IP, not a docker hostname)
CORE_CONF_fs_defaultFS=hdfs://10.100.200.101:9000

# Three DataNodes -> full redundancy: every block copied to all 3 nodes
# (survives up to 2 nodes offline). Needs >=3 live datanodes to fully satisfy;
# with fewer live nodes, blocks stay under-replicated until the rest join.
HDFS_CONF_dfs_replication=3

# Don't reverse-resolve DataNode IPs to hostnames (cross-host registration)
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname___check=false

# NameNode binds all interfaces inside the container but advertises fs.defaultFS host
HDFS_CONF_dfs_namenode_rpc___bind___host=0.0.0.0
HDFS_CONF_dfs_namenode_servicerpc___bind___host=0.0.0.0
HDFS_CONF_dfs_namenode_http___bind___host=0.0.0.0

# Reach DataNodes by their advertised hostname/IP (works through Docker port-publish)
HDFS_CONF_dfs_client_use_datanode_hostname=true
HDFS_CONF_dfs_datanode_use_datanode_hostname=true
